{
  "projectId": "demo-site",
  "scope": {
    "url": "demo.invalid",
    "matchType": "domain",
    "from": "1998",
    "to": "1999",
    "seedUrls": [],
    "dependencyHosts": [
      "demo.invalid"
    ]
  },
  "budgets": {
    "maxRequests": 50,
    "maxIndexRequests": 5,
    "maxTotalBytes": 1048576,
    "maxResponseBytes": 262144,
    "maxElapsedMs": 60000,
    "maxRedirects": 3,
    "maxAttemptsPerItem": 3,
    "maxPages": 10,
    "maxDependencies": 20
  },
  "provider": {
    "cdxEndpoint": "https://web.archive.org/cdx/search/cdx",
    "replayEndpoint": "https://web.archive.org/web",
    "allowedHosts": [
      "web.archive.org"
    ],
    "minRequestIntervalMs": 25,
    "requestTimeoutMs": 30000
  },
  "discovery": {
    "followRelations": [
      "stylesheet",
      "script",
      "image",
      "media",
      "frame",
      "object",
      "document"
    ],
    "followPageLinks": false
  },
  "outputDirectory": "tmp/demo-acquisition",
  "description": "Fixture project. minRequestIntervalMs is deliberately small because the fixture transport makes no provider requests; a live project keeps the polite default from src/config.ts."
}
