{
  "name": "resurrection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Recover a dead website from archive evidence and rebuild it with modern code.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "acquire": "node src/cli.ts",
    "acquire:fixture": "node src/fixture-demo.ts",
    "reclassify:fixture": "node src/cli.ts reclassify --job tmp/demo-acquisition"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
